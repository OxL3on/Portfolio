# ==========================================
# Application Environment Variables Example
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ==========================================

# Administrator Master Passcode (setup & authentication)
# Provide a cryptographically strong, random string (min 16 characters)
ADMIN_MASTER_PASSCODE=change_this_to_a_secure_random_passcode_minimum_16_chars

# Session Signing Secret (HMAC-SHA256 for session cookies)
# Must be at least 32 characters long. In multi-instance / cluster environments,
# this MUST be identical across all nodes.
SESSION_SECRET=change_this_to_a_secure_random_secret_minimum_32_characters_long

# Alias for backwards compatibility with previous configurations
ADMIN_SESSION_SECRET=

# Database Connection (Optional - defaults to local JSON storage if unset)
# For serverless / multi-container hosting (e.g. Vercel, ECS, K8s), configure MongoDB
MONGODB_URI=

# Optional Services
WEB3FORMS_ACCESS_KEY=
