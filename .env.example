# ==============================================================================
# Portfolio & CMS - Environment Variables Configuration Template
# ==============================================================================
# Instructions:
# 1. For local development: copy this file to .env.local (`cp .env.example .env.local`)
# 2. For production on Vercel: add these environment variables in your Vercel Project Settings
# 3. NEVER commit .env.local or actual secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE AUTHENTICATION & SECURITY (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# Session signing secret for HMAC-SHA256 cookie signatures.
# In production on Vercel, this MUST be a strong persistent secret of at least 32 characters.
# Generate one using: openssl rand -base64 32
SESSION_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long

# Administrator Master Passcode
# This is the secret password you enter on the secret admin login page (/luffy_secret_admin_panel_portfolio).
# Choose a strong passcode that you know. It will be securely hashed using scrypt before saving.
ADMIN_MASTER_PASSCODE=your_secret_admin_passcode_here

# Administrator Email (used for authorized Google OAuth login verification)
ADMIN_EMAIL=leonislamofficial123@gmail.com


# ------------------------------------------------------------------------------
# 2. MONGODB ATLAS (MANDATORY IN PRODUCTION ON VERCEL)
# ------------------------------------------------------------------------------
# Free Tier M0 MongoDB Atlas Cluster connection URI.
# Vercel serverless filesystem is read-only, so MongoDB Atlas provides persistent storage.
# Format: mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority

# Name of the database to use inside your MongoDB cluster
MONGODB_DB_NAME=portfolio_db


# ------------------------------------------------------------------------------
# 3. SUPABASE STORAGE (MANDATORY IN PRODUCTION FOR FILE UPLOADS)
# ------------------------------------------------------------------------------
# Supabase provides persistent object storage for portfolio images, avatars, and resume PDFs.
# Create a free project at https://supabase.com and create a Public Bucket named 'leon-portfolio-asset'.

# Project URL (Found under Project Settings -> API -> Project URL, e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Server-Side Secret Key (Found under Project Settings -> API -> Project API Keys / Secret Key)
# CRITICAL: Keep this server-side only. Do NOT prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# (Optional backward-compatibility alias)
# SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage Bucket name (must match your bucket name)
SUPABASE_STORAGE_BUCKET=leon-portfolio-asset


# ------------------------------------------------------------------------------
# 4. CONTACT FORM INTEGRATION (OPTIONAL)
# ------------------------------------------------------------------------------
# Access key from https://web3forms.com for the public contact section
WEB3FORMS_ACCESS_KEY=


# ------------------------------------------------------------------------------
# 5. FIREBASE CLIENT CONFIGURATION (OPTIONAL FOR GOOGLE OAUTH LOGIN)
# ------------------------------------------------------------------------------
# These client-side credentials initialize Firebase for the Google Sign-in popup on the admin page.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
